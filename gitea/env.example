# 基础域名
GITEA_DOMAIN=git.example.com
GITEA_ROOT_URL=https://git.example.com/

# Gitea 运行用户
USER_UID=1000
USER_GID=1000

# PostgreSQL
POSTGRES_DB=gitea
POSTGRES_USER=gitea
POSTGRES_PASSWORD=change-me

# Gitea 数据库连接
GITEA_DB_TYPE=postgres
GITEA_DB_HOST=postgres:5432
GITEA_DB_NAME=gitea
GITEA_DB_USER=gitea
GITEA_DB_PASSWD=change-me
GITEA_SECRET_KEY=replace-with-a-long-random-secret

# SSH
GITEA_SSH_DOMAIN=git.example.com
GITEA_SSH_PORT=12222

# HTTP
GITEA_HTTP_PORT=13000

# LFS Gateway
LFS_GATEWAY_PORT=18080
LFS_PUBLIC_URL=https://git.example.com
LFS_SIGN_EXPIRES=30m
LFS_VERIFY_SECRET=replace-with-a-long-random-secret
LFS_META_DB_DRIVER=postgres
LFS_META_DB_DSN=host=postgres port=5432 user=gitea password=change-me dbname=gitea sslmode=disable

# Aliyun OSS
OSS_ENDPOINT=https://oss-cn-hangzhou.aliyuncs.com
OSS_BUCKET=your-bucket
OSS_KEY_PREFIX=gitea-lfs
OSS_KEY_STYLE=repo

# Gitea's S3-compatible attachment driver expects an endpoint without https://.
GITEA_ATTACHMENT_OSS_ENDPOINT=s3.oss-cn-hangzhou.aliyuncs.com
GITEA_ATTACHMENT_OSS_LOCATION=cn-hangzhou

# Release direct upload
RELEASE_DIRECT_UPLOAD=true
RELEASE_ATTACHMENT_OSS_PREFIX=gitea/attachments
RELEASE_PENDING_OSS_PREFIX=gitea/release-upload-pending
RELEASE_MAX_FILE_SIZE_MB=5120
RELEASE_MAX_FILES=200

# Do not put AccessKey values in this file. lfs-gateway reads them from host env:
# ALIYUN_OSS_ACCESS_KEY_ID
# ALIYUN_OSS_ACCESS_KEY_SECRET

# Aliyun CDN URL auth Type A
CDN_BASE_URL=https://cdn.example.com
CDN_AUTH_KEY=your-cdn-url-auth-key
CDN_AUTH_UID=0
